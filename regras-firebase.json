        ".write": "((root.child('usuarios').child(auth.uid).child('tropa').val() === 'diretoria') || (root.child('usuarios').child(auth.uid).child('funcao').val() !== 'assistente' && root.child('usuarios').child(auth.uid).child('tropa').val() !== null && root.child('usuarios').child(auth.uid).child('tropa').val() !== 'diretoria' && (data.child('tropa').val() === root.child('usuarios').child(auth.uid).child('tropa').val() || (!data.exists() && newData.child('tropa').val() === root.child('usuarios').child(auth.uid).child('tropa').val())) && newData.child('tropa').val() === root.child('usuarios').child(auth.uid).child('tropa').val())) && data.child('admin').val() !== true && newData.child('admin').val() !== true && (data.child('senha').val() === newData.child('senha').val()) && (data.exists() || newData.child('funcao').val() === 'assistente' || (root.child('usuarios').child(auth.uid).child('tropa').val() === 'diretoria'))"
      }
