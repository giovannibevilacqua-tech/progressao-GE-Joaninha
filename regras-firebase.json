        ".write": "root.child('usuarios').child(auth.uid).child('admin').val() === true || (root.child('usuarios').child(auth.uid).child('tropa').val() === 'diretoria' || root.child('usuarios').child(auth.uid).child('tropa2').val() === 'diretoria') || (root.child('usuarios').child(auth.uid).child('tropa').val() === $sec || root.child('usuarios').child(auth.uid).child('tropa2').val() === $sec)"
