        ".write": "root.child('usuarios').child(auth.uid).child('admin').val() === true || ($sec === 'grupo' && (root.child('usuarios').child(auth.uid).child('tropa').val() === 'diretoria' || root.child('usuarios').child(auth.uid).child('tropa2').val() === 'diretoria')) || ($sec !== 'grupo' && (root.child('usuarios').child(auth.uid).child('tropa').val() === $sec || root.child('usuarios').child(auth.uid).child('tropa2').val() === $sec))",
